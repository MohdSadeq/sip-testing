# ─────────────────────────────────────────────────────────────
# SIP trunk test configuration  (IP-whitelisted trunk)
# Fill this in ON THE SERVER whose IP the provider has whitelisted.
# Lines starting with # are comments. No quotes needed around values.
# ─────────────────────────────────────────────────────────────

# --- Trunk / provider (REQUIRED) -------------------------------
# The provider's SIP server. Hostname or IP. This is where OPTIONS
# and INVITE are sent.
SIP_HOST=sip.provider.example.com
SIP_PORT=5060
# Transport: udp (only udp is implemented in the pure-python tester)
SIP_TRANSPORT=udp

# --- Your identity on the trunk --------------------------------
# For IP-authenticated trunks there is usually no username/password.
# FROM_USER is the caller number/user the provider expects you to
# present (often your main DID or account number). Some providers
# don't care; set it to your DID to be safe.
FROM_USER=100
# The IP/host the provider sees you as. Leave AUTO to auto-detect
# the server's outbound IP. Override only if you sit behind 1:1 NAT
# and must advertise the public IP in SIP/SDP.
LOCAL_IP=AUTO
# Local UDP port the tester binds to for signalling.
LOCAL_PORT=5062

# --- Caller ID for outbound test calls -------------------------
# Number to present as caller ID (E.164 or as your provider requires).
CALLER_ID=

# --- Outbound call test ----------------------------------------
# Number to dial for the INVITE test. E.164 or provider format.
DIAL_TARGET=

# --- Optional digest auth --------------------------------------
# LEAVE BLANK for pure IP whitelist. If the trunk challenges with
# 401/407 and you DO have credentials, fill these and the tester
# will answer the digest challenge.
AUTH_USER=
AUTH_PASS=

# --- Behaviour tuning ------------------------------------------
# Seconds to wait for SIP responses.
TIMEOUT=5
# For the call test: seconds to stay in the call after 200 OK
# before sending BYE (0 = hang up immediately after answer).
CALL_HOLD_SECONDS=3
